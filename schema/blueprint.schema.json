{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/pilapipi/figma-ui-blueprint-builder/schema/blueprint.schema.json",
  "title": "UI Blueprint Builder",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "project",
    "tokens",
    "components",
    "sections"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "outputPage"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "outputPage": {
          "type": "string",
          "minLength": 1
        },
        "componentPage": {
          "type": "string",
          "minLength": 1
        },
        "buildMode": {
          "enum": [
            "replace-generated",
            "preserve-existing"
          ]
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "figma",
                "screenshots",
                "mixed"
              ]
            },
            "documentName": {
              "type": "string"
            },
            "documentUrl": {
              "type": "string"
            },
            "notes": {
              "type": "string"
            }
          }
        }
      }
    },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "colors",
        "typography"
      ],
      "properties": {
        "colors": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/color"
          }
        },
        "spacing": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        },
        "radii": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        },
        "typography": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/typography"
          }
        }
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^data:image/.+;base64,"
      }
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/component"
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/section"
      }
    }
  },
  "$defs": {
    "color": {
      "type": "string",
      "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
    },
    "tokenNumber": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "typography": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "size"
      ],
      "properties": {
        "family": {
          "type": "string"
        },
        "style": {
          "type": "string"
        },
        "size": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "lineHeight": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "letterSpacing": {
          "type": "number"
        }
      }
    },
    "paint": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "color"
          ],
          "properties": {
            "type": {
              "const": "solid"
            },
            "color": {
              "type": "string",
              "minLength": 1
            },
            "opacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "stops"
          ],
          "properties": {
            "type": {
              "const": "linear-gradient"
            },
            "stops": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "position",
                  "color"
                ],
                "properties": {
                  "position": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "color": {
                    "type": "string",
                    "minLength": 1
                  },
                  "opacity": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              }
            }
          }
        }
      ]
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "none",
            "vertical",
            "horizontal"
          ]
        },
        "gap": {
          "$ref": "#/$defs/tokenNumber"
        },
        "padding": {
          "oneOf": [
            {
              "$ref": "#/$defs/tokenNumber"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "top": {
                  "$ref": "#/$defs/tokenNumber"
                },
                "right": {
                  "$ref": "#/$defs/tokenNumber"
                },
                "bottom": {
                  "$ref": "#/$defs/tokenNumber"
                },
                "left": {
                  "$ref": "#/$defs/tokenNumber"
                }
              }
            }
          ]
        },
        "align": {
          "enum": [
            "start",
            "center",
            "end",
            "stretch"
          ]
        },
        "justify": {
          "enum": [
            "start",
            "center",
            "end",
            "space-between"
          ]
        }
      }
    },
    "shadow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blur"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "blur": {
          "type": "number",
          "minimum": 0
        },
        "spread": {
          "type": "number"
        },
        "color": {
          "type": "string"
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "boxProperties": {
      "type": "object",
      "properties": {
        "fill": {
          "$ref": "#/$defs/paint"
        },
        "stroke": {
          "$ref": "#/$defs/paint"
        },
        "strokeWidth": {
          "type": "number",
          "minimum": 0
        },
        "radius": {
          "$ref": "#/$defs/tokenNumber"
        },
        "shadow": {
          "$ref": "#/$defs/shadow"
        },
        "layout": {
          "$ref": "#/$defs/layout"
        },
        "clip": {
          "type": "boolean"
        }
      }
    },
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "type": {
          "enum": [
            "frame",
            "text",
            "rectangle",
            "ellipse",
            "line",
            "instance",
            "svg",
            "image"
          ]
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "rotation": {
          "type": "number"
        },
        "visible": {
          "type": "boolean"
        },
        "locked": {
          "type": "boolean"
        },
        "grow": {
          "type": "boolean"
        },
        "stretch": {
          "type": "boolean"
        },
        "fill": {
          "$ref": "#/$defs/paint"
        },
        "stroke": {
          "$ref": "#/$defs/paint"
        },
        "strokeWidth": {
          "type": "number",
          "minimum": 0
        },
        "radius": {
          "$ref": "#/$defs/tokenNumber"
        },
        "shadow": {
          "$ref": "#/$defs/shadow"
        },
        "layout": {
          "$ref": "#/$defs/layout"
        },
        "clip": {
          "type": "boolean"
        },
        "layers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/layer"
          }
        },
        "text": {
          "type": "string"
        },
        "textStyle": {
          "type": "string"
        },
        "fontFamily": {
          "type": "string"
        },
        "fontStyle": {
          "type": "string"
        },
        "fontSize": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "lineHeight": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "letterSpacing": {
          "type": "number"
        },
        "color": {
          "type": "string"
        },
        "align": {
          "enum": [
            "left",
            "center",
            "right"
          ]
        },
        "verticalAlign": {
          "enum": [
            "top",
            "center",
            "bottom"
          ]
        },
        "componentId": {
          "type": "string"
        },
        "overrides": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "svg": {
          "type": "string"
        },
        "assetId": {
          "type": "string"
        },
        "fit": {
          "enum": [
            "fill",
            "fit",
            "crop",
            "tile"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "text"
              }
            }
          },
          "then": {
            "required": [
              "text"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "instance"
              }
            }
          },
          "then": {
            "required": [
              "componentId"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "svg"
              }
            }
          },
          "then": {
            "required": [
              "svg"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "image"
              }
            }
          },
          "then": {
            "required": [
              "assetId"
            ]
          }
        }
      ]
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "width",
        "height",
        "layers"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "fill": {
          "$ref": "#/$defs/paint"
        },
        "stroke": {
          "$ref": "#/$defs/paint"
        },
        "strokeWidth": {
          "type": "number",
          "minimum": 0
        },
        "radius": {
          "$ref": "#/$defs/tokenNumber"
        },
        "shadow": {
          "$ref": "#/$defs/shadow"
        },
        "layout": {
          "$ref": "#/$defs/layout"
        },
        "clip": {
          "type": "boolean"
        },
        "layers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/layer"
          }
        }
      }
    },
    "screen": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "width",
        "height",
        "layers"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "asComponent": {
          "type": "boolean"
        },
        "fill": {
          "$ref": "#/$defs/paint"
        },
        "radius": {
          "$ref": "#/$defs/tokenNumber"
        },
        "layout": {
          "$ref": "#/$defs/layout"
        },
        "clip": {
          "type": "boolean"
        },
        "layers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/layer"
          }
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "screens"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "layout": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "columns": {
              "type": "integer",
              "minimum": 1
            },
            "gap": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "screens": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/screen"
          }
        }
      }
    }
  }
}
